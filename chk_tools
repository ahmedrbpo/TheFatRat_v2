#!/bin/bash
# ============================================================
# chk_tools
# Consolidated modern Android development toolchain checker
# ============================================================
#
# Purpose:
#   Check whether common Android development/reverse-engineering
#   utilities are installed and report their versions.
#
# Important:
#   - DX is obsolete; D8 is checked as the modern replacement.
#   - This checker does NOT remove, purge, downgrade, or replace tools.
#   - This checker does NOT generate APK payloads or backdoors.
#
# ============================================================

set -u

PASS=0
FAIL=0

line() {
    printf '%*s\n' 62 '' | tr ' ' '-'
}

print_version() {
    local tool="$1"
    shift

    if command -v "$tool" >/dev/null 2>&1; then
        local path
        path="$(command -v "$tool")"
        printf "[✔] %-12s %s\n" "$tool" "$path"

        local output
        output="$("$@" 2>&1 | head -n 2 || true)"

        if [ -n "$output" ]; then
            while IFS= read -r l; do
                printf "    %s\n" "$l"
            done <<< "$output"
        fi

        PASS=$((PASS + 1))
    else
        printf "[✘] %-12s NOT FOUND\n" "$tool"
        FAIL=$((FAIL + 1))
    fi
}

echo
echo "============================================================"
echo "          ANDROID TOOLCHAIN VERSION CHECK"
echo "============================================================"
echo

echo "[*] System:"
if command -v uname >/dev/null 2>&1; then
    uname -a
fi

echo
echo "[*] Java:"
if command -v java >/dev/null 2>&1; then
    java -version 2>&1 | head -n 2
else
    echo "    Java: NOT FOUND"
fi

echo
line
echo " Android SDK / Platform Tools"
line

print_version adb adb version
print_version aapt aapt version
print_version aapt2 aapt2 version
print_version d8 d8 --version
print_version zipalign zipalign -h
print_version apksigner apksigner version

echo
line
echo " APK / DEX Utilities"
line

print_version apktool apktool --version
print_version baksmali baksmali --version
print_version smali smali --version

echo
line
echo " Legacy DX Check"
line

if command -v dx >/dev/null 2>&1; then
    echo "[i] dx found at: $(command -v dx)"
    dx --version 2>&1 | head -n 2
    echo "[i] Modern Android builds normally use d8 instead of dx."
else
    echo "[i] dx not found."
    echo "[i] This is normally expected on a current Android toolchain."
fi

echo
line
echo " Android SDK Environment"
line

if [ -n "${ANDROID_HOME:-}" ]; then
    echo "[✔] ANDROID_HOME=$ANDROID_HOME"
else
    echo "[i] ANDROID_HOME is not set"
fi

if [ -n "${ANDROID_SDK_ROOT:-}" ]; then
    echo "[✔] ANDROID_SDK_ROOT=$ANDROID_SDK_ROOT"
else
    echo "[i] ANDROID_SDK_ROOT is not set"
fi

echo
line
echo " Summary"
line

echo "Available tools : $PASS"
echo "Missing tools   : $FAIL"

echo
echo "Notes:"
echo "  * d8 is checked instead of requiring legacy dx."
echo "  * aapt and aapt2 are checked independently."
echo "  * Installed apktool/smali/baksmali versions are reported"
echo "    without forcing an obsolete hard-coded version."
echo "  * No installed tool is removed or replaced."
echo
echo "============================================================"
echo "                    CHECK COMPLETE"
echo "============================================================"
echo

exit 0
